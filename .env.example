# ==============================================================================
# AETHER ACADEMY: ADVANCED EDUCATIONAL AI CHATBOT
# Environment Configuration - URL API Connectivity (Zero API Keys Required)
# ==============================================================================

# Open-Source Model Inference via URL API
# Default: Free Open-Source Model Cluster (Pollinations OpenAI-compatible URL API)
# Alternatively: Local Ollama (http://localhost:11434/v1) or Local/Remote vLLM (http://localhost:8000/v1)
INFERENCE_BASE_URL="https://text.pollinations.ai"
INFERENCE_MODEL="openai-fast"
FALLBACK_MODEL="Qwen/Qwen2.5-72B-Instruct"

# Optional: If your remote custom GPU server requires a bearer token, provide it here. Otherwise, leave empty.
INFERENCE_API_KEY=""

# Vector Embeddings & Hybrid RAG Model
EMBEDDING_MODEL="text-embedding-3-small"

# Optional: PostgreSQL Database with pgvector (Supabase, Neon, or local Postgres)
# When omitted, Aether Academy runs with its high-speed built-in persistent storage.
DATABASE_URL="postgresql://postgres:password@localhost:5432/aether_academy?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/aether_academy?schema=public"

# Optional: NextAuth session secret
AUTH_SECRET="aether-academic-secure-session-key-hex"
NEXTAUTH_URL="http://localhost:3000"
