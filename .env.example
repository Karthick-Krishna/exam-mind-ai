# ==============================================================================
# EXAM MIND AI: ELITE EDUCATIONAL AI & REAL-TIME SEARCH ENGINE
# Environment Configuration - URL API Connectivity (Zero API Keys Required)
# ==============================================================================

# High-Level Open-Source Model Inference via URL API or Local Ollama
# Default: Local Ollama (http://localhost:11434/v1) with Google Gemma 3, or Free URL API Cluster
INFERENCE_BASE_URL="http://localhost:11434/v1"
INFERENCE_MODEL="gemma3:4b"
FALLBACK_MODEL="openai-fast"

# Optional: If your remote custom GPU server requires a bearer token, provide it here. Otherwise, leave empty.
INFERENCE_API_KEY=""

# Optional: Google Custom Search Engine (CSE) API
# If configured, EXAM MIND AI uses official Google CSE. If omitted, it automatically uses the live web search engine.
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""

# Optional: Self-hosted SearXNG search instance
SEARXNG_URL=""

# Vector Embeddings & Hybrid RAG Model
EMBEDDING_MODEL="text-embedding-3-small"

# Optional: PostgreSQL Database with pgvector (Supabase, Neon, or local Postgres)
# When omitted, EXAM MIND AI runs with its high-speed built-in persistent storage.
DATABASE_URL="postgresql://postgres:password@localhost:5432/exam_mind_ai?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/exam_mind_ai?schema=public"

# Optional: NextAuth session secret
AUTH_SECRET="exam-mind-secure-session-key-hex"
NEXTAUTH_URL="http://localhost:3000"
