# ==============================================================================
# EXAM MIND AI: CONFIGURATION TEMPLATE
# Dual Open-Source AI Inference (GPT-OSS & Qwen 2.5), Multi-Source Search & RAG
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model 1: GPT-OSS (Primary General-Purpose, Academic & Deep Search Engine)
# Supports OpenAI-compatible endpoints: vLLM, Ollama, Groq, OpenRouter, or Pollinations
# ------------------------------------------------------------------------------
GPT_OSS_BASE_URL="https://text.pollinations.ai"
GPT_OSS_API_KEY=""
GPT_OSS_MODEL="openai-fast"

# ------------------------------------------------------------------------------
# 2. Model 2: Qwen (Programming, Mathematics, Logic & Independent Fallback)
# Supports OpenAI-compatible endpoints: vLLM, Ollama, Groq, OpenRouter, or Pollinations
# ------------------------------------------------------------------------------
QWEN_BASE_URL="https://text.pollinations.ai"
QWEN_API_KEY=""
QWEN_MODEL="qwen-coder"

# ------------------------------------------------------------------------------
# 3. Live Web Search & Metasearch Engine
# When SEARCH_PROVIDER_URL is provided, queries the configured SearXNG metasearch instance.
# When omitted, EXAM MIND AI automatically scrapes Google & DuckDuckGo across all domains.
# ------------------------------------------------------------------------------
SEARCH_PROVIDER_URL=""

# Optional: Google Custom Search Engine (CSE) API
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""

# ------------------------------------------------------------------------------
# 4. Vector Embeddings & Hybrid RAG Knowledge Base
# Supports OpenAI-compatible embeddings (e.g. text-embedding-3-small) with local vector hashing
# ------------------------------------------------------------------------------
EMBEDDING_MODEL="text-embedding-3-small"

# ------------------------------------------------------------------------------
# 5. Database & Persistent Storage (PostgreSQL with pgvector)
# When omitted or unconfigured, runs with built-in persistent storage in .data/db.json
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/exam_mind_ai?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/exam_mind_ai?schema=public"

# Optional: NextAuth session secret
AUTH_SECRET="exam-mind-secure-session-key-hex"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Legacy / Unified Fallbacks (For backward compatibility)
# ------------------------------------------------------------------------------
INFERENCE_BASE_URL="https://text.pollinations.ai"
INFERENCE_MODEL="gpt-oss"
FALLBACK_MODEL="qwen-oss"
